{
  "manifest_version": 3,
  "name": "Panafargo Sync",
  "version": "4.0.0",
  "description": "Consulta productos de Shopify por SKU, los valida, genera el lote de Rappi y lo sube directamente en Mi Tienda (V1.0 / V1.1 / V2 / V4).",
  "action": {
    "default_title": "Panafargo Sync"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "downloads", "windows"],
  "host_permissions": [
    "https://*.myshopify.com/*",
    "https://cdn.shopify.com/*",
    "https://mitienda.rappi.com.co/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://mitienda.rappi.com.co/*"],
      "js": ["vendor/xlsx.full.min.js", "rappi/mi-tienda-content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["rappi/ProductosAsociacion-es.xlsx"],
      "matches": ["https://mitienda.rappi.com.co/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
