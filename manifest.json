{
  "manifest_version": 3,
  "name": "Panafargo Sync",
  "version": "4.1.5",
  "description": "Busca productos y diseños de Shopify por SKU, revisa existencias y prepara su creación y asociación en Rappi.",
  "action": {
    "default_title": "Panafargo Sync"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "downloads"],
  "host_permissions": [
    "https://*.myshopify.com/*",
    "https://cdn.shopify.com/*",
    "https://mitienda.rappi.com.co/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://mitienda.rappi.com.co/*"],
      "js": ["vendor/xlsx.full.min.js", "rappi/mi-tienda-imagenes.js", "rappi/mi-tienda-content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
